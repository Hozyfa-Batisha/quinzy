# Public hostname for Quinzy. Copy this file to .env before deployment.
# The DNS A/AAAA record for this hostname must point to the Docker server.
QUINZY_HOSTNAME=quinzy.example.com

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Secret string used to sign JWT session tokens (generate a long, random string)
JWT_SECRET=super-secret-production-key
